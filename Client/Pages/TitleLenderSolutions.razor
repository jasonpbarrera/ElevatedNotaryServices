@page "/title-lender-solutions"

<PageTitle>Title &amp; Lender Signing Solutions | Elevated Notary Services</PageTitle>
<HeadContent>
    <meta name="description" content="50-state loan signing coordination for title companies, lenders, escrow officers, and attorneys. $1,000,000 E&amp;O insured, background-checked signing agents, and Notary Everyday portal integration." />
</HeadContent>

<section class="page-hero">
    <div class="container">
        <span class="eyebrow eyebrow-light">B2B Institutional Signing Coordination</span>
        <h1>Title &amp; Lender Solutions</h1>
        <p>
            Dependable nationwide loan signing coverage backed by $1,000,000 in Errors &amp; Omissions coverage, proactive communication, and structured pre-delivery document review.
        </p>
    </div>
</section>

<!-- Partner Portal Gateway (Replaces clunky Google Sites iframes) -->
<section class="section">
    <div class="container">
        <div class="section-header">
            <span class="eyebrow">Notary Everyday Integration</span>
            <h2 class="section-title">Client Order Portal &amp; Rapid Dispatch</h2>
            <p class="section-lead">
                Manage orders, upload closing packages, and track real-time signing milestones directly through our secure Notary Everyday partner platform — or submit a quick dispatch request below.
            </p>
        </div>

        <div class="grid-3">
            <div class="card card-featured">
                <div class="card-icon" aria-hidden="true">🔐</div>
                <h3>Existing Client Login</h3>
                <p>Log in to place new signing orders, upload loan docs, review scanbacks, and message our coordination desk.</p>
                <div class="card-footer-cta">
                    <a href="https://www.notaryeveryday.com/client-login/90" target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="width:100%;">
                        Open Client Portal ↗
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-icon" aria-hidden="true">✨</div>
                <h3>New Client Account Setup</h3>
                <p>First time working with Elevated Notary Services? Register your title company, lender desk, or law firm in minutes.</p>
                <div class="card-footer-cta">
                    <a href="https://www.notaryeveryday.com/client-signup/90" target="_blank" rel="noopener noreferrer" class="btn btn-navy" style="width:100%;">
                        Create Partner Account ↗
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-icon" aria-hidden="true">⚡</div>
                <h3>Quick Signing Request</h3>
                <p>Need urgent same-day, evening, or weekend coverage right now? Send us the assignment details for immediate confirmation.</p>
                <div class="card-footer-cta">
                    <a href="/request-signing" class="btn btn-outline-navy" style="width:100%;">
                        Submit Signing Request →
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

