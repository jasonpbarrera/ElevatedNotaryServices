@page "/contact"
@inject HttpClient Http

<PageTitle>Contact &amp; Cleveland, TN Storefront | Elevated Notary Services</PageTitle>
<HeadContent>
    <meta name="description" content="Visit Elevated Notary Services at 130 Bernham Dr NW, Cleveland, TN 37312 (walk-ins welcome), call (423) 375-8770, or send us a message for nationwide signing coordination and local notary service." />
</HeadContent>

<section class="page-hero">
    <div class="container">
        <span class="eyebrow eyebrow-light">Get In Touch</span>
        <h1>Contact &amp; Cleveland, TN Storefront</h1>
        <p>Walk-ins welcome at our Cleveland office, or connect with our nationwide coordination desk by phone, email, or online inquiry.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="grid-2" style="align-items:start;">
            <div style="display:grid; gap:1.5rem;">
                <div class="card card-featured">
                    <span class="eyebrow eyebrow-light">Walk-Ins Welcome</span>
                    <h2 style="font-size:1.85rem; margin:0.35rem 0 0.75rem; color:#fff;">Cleveland, TN Storefront</h2>
                    <p style="font-size:1rem; margin-bottom:1.1rem;">
                        <strong>130 Bernham Dr NW</strong><br />
                        Cleveland, TN 37312
                    </p>
                    <a href="https://www.google.com/maps/dir/?api=1&destination=Elevated+Notary+Services%2C+130+Bernham+Dr+NW%2C+Cleveland%2C+TN+37312&travelmode=driving"
                       target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="width:fit-content;">
                        Get Driving Directions ↗
                    </a>
                </div>

                <div class="card">
                    <h3>Direct Contact &amp; Hours</h3>
                    <ul class="check-list">
                        <li><strong>Office Phone:</strong> <a href="tel:4233758770">(423) 375-8770</a></li>
                        <li><strong>Direct Line:</strong> <a href="tel:4237152065">(423) 715-2065</a></li>
                        <li><strong>Email:</strong> <a href="mailto:Bhsmith@elevatednotaryservs.com">Bhsmith@elevatednotaryservs.com</a></li>
                        <li><strong>Monday–Friday:</strong> 8:30 AM – 8:00 PM ET</li>
                        <li><strong>Saturday:</strong> 10:00 AM – 4:00 PM ET</li>
                        <li><strong>Sunday:</strong> By Appointment Only</li>
                    </ul>
                    <p style="font-size:0.88rem; color:var(--text-muted); margin:0;">
                        After-hours, evening, weekend, and emergency signing assignments may be accommodated upon request.
                    </p>
                </div>
            </div>

            <div class="form-card">
                <h2 style="font-size:1.85rem; margin-bottom:0.4rem;">Send Us a Message</h2>
                <p style="color:var(--text-muted); margin:0 0 1.4rem; font-size:0.93rem;">
                    Have a question about a document, travel fee, or title partnership? Reach out and we’ll respond promptly.
                </p>

                @if (sent)
                {
                    <div class="alert-success" role="status">
                        <h3 style="margin-bottom:0.35rem; color:#065F46;">Message Sent</h3>
                        <p style="margin:0; color:#065F46;">Thank you for contacting Elevated Notary Services. We will get back to you shortly.</p>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert-error" role="alert" style="margin-bottom:1rem;">@error</div>
                    }

                    <EditForm Model="form" OnValidSubmit="SendMessage" class="form-grid">
                        <DataAnnotationsValidator />
                        <div class="hp-field" aria-hidden="true">
                            <InputText @bind-Value="form.Honeypot" tabindex="-1" autocomplete="off" />
                        </div>
                        <div class="form-group">
                            <label for="c-name">Full Name *</label>
                            <InputText id="c-name" class="form-control" @bind-Value="form.Name" required />
                        </div>
                        <div class="form-grid form-grid-2">
                            <div class="form-group">
                                <label for="c-email">Email *</label>
                                <InputText id="c-email" type="email" class="form-control" @bind-Value="form.Email" required />
                            </div>
                            <div class="form-group">
                                <label for="c-phone">Phone *</label>
                                <InputText id="c-phone" type="tel" class="form-control" @bind-Value="form.Phone" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="c-msg">How can we help? *</label>
                            <InputTextArea id="c-msg" class="form-control" @bind-Value="form.Message" required />
                        </div>
                        <button type="submit" class="btn btn-navy" disabled="@sending" style="width:100%;">
                            @(sending ? "Sending..." : "Send Message")
                        </button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private ContactModel form = new();
    private bool sending;
    private bool sent;
    private string? error;

    private async Task SendMessage()
    {
        sending = true;
        error = null;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/leads", new
            {
                clientCategory = "Contact Page Inquiry",
                name = form.Name,
                email = form.Email,
                phone = form.Phone,
                serviceType = "General Inquiry",
                message = form.Message,
                honeypot = form.Honeypot
            });
            if (resp.IsSuccessStatusCode)
            {
                sent = true;
            }
            else
            {
                error = "Unable to send message right now. Please call (423) 375-8770.";
            }
        }
        catch
        {
            error = "Connection error. Please call (423) 375-8770.";
        }
        finally
        {
            sending = false;
        }
    }

    public class ContactModel
    {
        [Required] public string Name { get; set; } = "";
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required] public string Phone { get; set; } = "";
        [Required] public string Message { get; set; } = "";
        public string Honeypot { get; set; } = "";
    }
}
